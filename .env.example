# Copia este archivo como .env para desarrollo local.
# El servidor carga .env automaticamente (dotenv). .env esta en .gitignore: NO se versiona.

# Autenticación inicial del superadmin (cámbialas en producción)
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=cambia-esta-clave

# MongoDB — cadena de conexión.
# PRODUCCIÓN usa la base 'gestion-reservas' (configurada en Vercel, NO aquí).
# DESARROLLO LOCAL: usar una BASE SEPARADA para no tocar los datos de producción.
#   Ejemplo con base separada en el mismo cluster Atlas (nota el nombre de base distinto):
#   MONGODB_URI=mongodb+srv://USUARIO:CLAVE@clusterm0.dkfhb4f.mongodb.net/reserva-salas-dev?retryWrites=true&w=majority
MONGODB_URI=

# Puerto local del API (opcional, por defecto 3001)
# PORT=3001
